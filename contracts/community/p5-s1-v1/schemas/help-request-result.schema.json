{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lifebridge.local/contracts/community/p5-s1-v1/schemas/help-request-result.schema.json",
  "title": "P5-S1 help-request result",
  "oneOf": [
    { "$ref": "#/$defs/ListProjection" },
    { "$ref": "#/$defs/MutationResult" },
    { "$ref": "#/$defs/DeleteResult" }
  ],
  "$defs": {
    "OpaqueId": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "SubmissionReference": {
      "type": "string",
      "minLength": 12,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "Category": {
      "enum": [
        "daily_living_support",
        "transport_coordination",
        "household_errand",
        "social_connection",
        "digital_access",
        "accessibility_support"
      ]
    },
    "DayPart": {
      "oneOf": [
        { "enum": ["flexible", "morning", "afternoon", "evening"] },
        { "type": "null" }
      ]
    },
    "RequestProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestId",
        "submissionReference",
        "category",
        "locationGranularity",
        "provinceCityCode",
        "dayPart",
        "visibility",
        "status",
        "submissionOutcome",
        "matchingState",
        "retentionPolicy",
        "version",
        "confirmedAt",
        "pendingAutoCloseAt",
        "closedAt",
        "purgeAfter"
      ],
      "properties": {
        "requestId": { "$ref": "#/$defs/OpaqueId" },
        "submissionReference": { "$ref": "#/$defs/SubmissionReference" },
        "category": { "$ref": "#/$defs/Category" },
        "locationGranularity": { "const": "province_city" },
        "provinceCityCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 32,
          "pattern": "^[A-Z0-9-]+$"
        },
        "dayPart": { "$ref": "#/$defs/DayPart" },
        "visibility": { "const": "current_request_collaborators" },
        "status": { "enum": ["pending", "closed"] },
        "submissionOutcome": { "const": "confirmed" },
        "matchingState": { "const": "unavailable_in_p5_s1" },
        "retentionPolicy": {
          "const": "pending_30d_closed_30d_then_purge"
        },
        "version": { "type": "integer", "minimum": 1 },
        "confirmedAt": { "type": "string", "format": "date-time" },
        "pendingAutoCloseAt": { "type": "string", "format": "date-time" },
        "closedAt": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "purgeAfter": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        }
      }
    },
    "ListProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "serverTime"],
      "properties": {
        "requests": {
          "type": "array",
          "maxItems": 25,
          "items": { "$ref": "#/$defs/RequestProjection" }
        },
        "serverTime": { "type": "string", "format": "date-time" }
      }
    },
    "MutationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "duplicate", "request", "confirmedAt"],
      "properties": {
        "outcome": { "enum": ["submitted", "closed"] },
        "duplicate": { "type": "boolean" },
        "request": { "$ref": "#/$defs/RequestProjection" },
        "confirmedAt": { "type": "string", "format": "date-time" }
      }
    },
    "DeleteResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "deletedRequestId", "confirmedAt"],
      "properties": {
        "outcome": { "const": "deleted" },
        "deletedRequestId": { "$ref": "#/$defs/OpaqueId" },
        "confirmedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
