# Safe, non-secret application defaults.
# Copy values into an ignored local environment file only when a service requires it.
LIFEBRIDGE_ENV=development
LIFEBRIDGE_LOG_LEVEL=info
LIFEBRIDGE_DEMO_MODE=fixture

# Add service credentials only through an approved local secret mechanism.
# CARE_CURSOR_KEY is a required Care secret and must be distinct from the
# Care internal-service token; do not place either value in this file.
# Never place Stitch credentials in application runtime environment files.
