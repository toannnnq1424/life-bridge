{
  "name": "@lifebridge/gateway",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format:check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start": "tsx src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --external:fastify --outfile=dist/main.mjs"
  },
  "dependencies": {
    "@lifebridge/config": "workspace:*",
    "@lifebridge/contracts": "workspace:*",
    "@lifebridge/observability": "workspace:*",
    "@lifebridge/test-fixtures": "workspace:*",
    "fastify": "5.10.0"
  }
}
