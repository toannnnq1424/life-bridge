{
  "name": "@lifebridge/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "format:check": "prettier --check .",
    "lint": "eslint \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\" next.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
