  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@lifebridge/contracts": "workspace:*",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  }
}
