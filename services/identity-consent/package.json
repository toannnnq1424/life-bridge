{
  "name": "@lifebridge/identity-consent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format:check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "migrate": "tsx src/migrate-cli.ts",
    "start": "tsx src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --external:fastify --external:pg --external:pg-native --external:@node-rs/argon2 --external:otpauth --outfile=dist/main.mjs"
  },
  "dependencies": {
    "@lifebridge/config": "workspace:*",
    "@lifebridge/contracts": "workspace:*",
    "@lifebridge/migrations": "workspace:*",
    "@lifebridge/observability": "workspace:*",
    "@node-rs/argon2": "2.0.2",
    "fastify": "5.10.0",
    "otpauth": "9.5.1",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/pg": "8.20.0"
  }
}
